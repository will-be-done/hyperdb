{
  "name": "@will-be-done/hyperdb",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/will-be-done/hyperdb.git",
    "directory": "packages/hyperdb"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./tracing": {
      "types": "./dist/hyperdb/tracing/index.d.ts",
      "import": "./dist/tracing.mjs",
      "require": "./dist/tracing.cjs"
    },
    "./drivers/inmemory": {
      "types": "./dist/hyperdb/drivers/inmemory/bptree-inmem-driver.d.ts",
      "import": "./dist/drivers/inmemory.mjs",
      "require": "./dist/drivers/inmemory.cjs"
    },
    "./drivers/sqlite": {
      "types": "./dist/hyperdb/drivers/sqlite/index.d.ts",
      "import": "./dist/drivers/sqlite.mjs",
      "require": "./dist/drivers/sqlite.cjs"
    },
    "./drivers/idb": {
      "types": "./dist/hyperdb/drivers/idb/idb-driver.d.ts",
      "import": "./dist/drivers/idb.mjs",
      "require": "./dist/drivers/idb.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "analyze": "ANALYZE=true vite build && tsc",
    "build": "vite build && tsc",
    "lint": "eslint .",
    "lint:cycles": "depcruise src --config .dependency-cruiser.cjs",
    "bench": "vitest bench",
    "prepack": "pnpm run build",
    "ts": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "@vitest/browser-playwright": "4.1.5",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "lexicodec": "^0.0.6",
    "playwright": "^1.61.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "sql.js": "^1.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.12",
    "vitest": "4.1.5"
  }
}
