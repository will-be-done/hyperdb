    "@vitest/browser-playwright": "4.1.5",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
