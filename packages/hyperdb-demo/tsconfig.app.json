{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "paths": {
      "@will-be-done/hyperdb": ["../hyperdb/src/index.ts"],
      "@will-be-done/hyperdb/react": ["../hyperdb/src/react.ts"],
      "@will-be-done/hyperdb/tracing": [
        "../hyperdb/src/hyperdb/tracing/index.ts"
      ],
      "@will-be-done/hyperdb/drivers/inmemory": [
        "../hyperdb/src/hyperdb/drivers/inmemory/bptree-inmem-driver.ts"
      ],
      "@will-be-done/hyperdb/drivers/sqlite": [
        "../hyperdb/src/hyperdb/drivers/sqlite/index.ts"
      ],
      "@will-be-done/hyperdb/drivers/idb": [
        "../hyperdb/src/hyperdb/drivers/idb/idb-driver.ts"
      ],
      "@will-be-done/hyperdb-devtool/react": [
        "../hyperdb-devtool/src/react.ts"
      ]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
